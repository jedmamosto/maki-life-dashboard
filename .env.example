# Maki Life Dashboard Environment Variables

# Secret household token used in /h/[token] (use 24+ random bytes in production)
HOUSEHOLD_TOKEN=maki-dev-household-token-change-in-prod

# 4-digit Owner PIN (default local dev PIN is 1234; hash stored in DB once changed in settings)
OWNER_DEFAULT_PIN=1234

# Secret used to sign HttpOnly household and owner-PIN session cookies
SESSION_SECRET=maki-dev-session-secret-change-in-prod

# Optional PostgreSQL (Neon) connection string; when omitted, uses local .data/maki-care.json
DATABASE_URL=

# Web Push VAPID keys (generate with: node scripts/generate-vapid.mjs)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com

# Upstash QStash signature verification keys for /api/cron/tick
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Resend API key and escalation recipient for Owner overdue/low-stock alerts
RESEND_API_KEY=
RESEND_FROM_EMAIL=Maki Care <onboarding@resend.dev>
OWNER_ALERT_EMAIL=

# Canonical app base URL for push deep-links and Messenger nudges
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Strictly keep false/unset in production; enables /api/test/reset for Playwright E2E
ENABLE_TEST_HARNESS=false
